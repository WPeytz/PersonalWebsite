---
import { NAV_LINKS, SITE_TITLE } from '@/consts';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 bg-bg/80 backdrop-blur border-b border-border">
  <div class="container-wide flex h-14 items-center justify-between gap-6">
    <a
      href="/"
      class="font-sans font-semibold tracking-tightest text-fg no-underline"
    >
      {SITE_TITLE}
    </a>

    <nav class="flex items-center gap-1 sm:gap-2 text-sm">
      {
        NAV_LINKS.filter((link) => link.href !== '/').map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-2 py-1 rounded-md no-underline transition-colors',
              isActive(link.href)
                ? 'text-fg'
                : 'text-fg-muted hover:text-fg',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <div class="ml-2">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
