---
import { Mail, Rss } from '@lucide/astro';
import { SOCIAL_LINKS } from '@/consts';

const iconClass = 'h-4 w-4';
const linkClass =
  'inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-fg-muted hover:text-fg hover:border-border-strong transition-colors no-underline';
---

<ul class="flex flex-wrap items-center gap-2">
  <li>
    <a href={SOCIAL_LINKS.email} aria-label="Email" title="Email" class={linkClass}>
      <Mail class={iconClass} aria-hidden="true" />
    </a>
  </li>
  <li>
    <a
      href={SOCIAL_LINKS.github}
      aria-label="GitHub"
      title="GitHub"
      target="_blank"
      rel="noopener noreferrer"
      class={linkClass}
    >
      <svg
        class={iconClass}
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.34 9.34 0 0 1 12 7.24c.85 0 1.7.12 2.5.34 1.9-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.81-4.58 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
        />
      </svg>
    </a>
  </li>
  <li>
    <a
      href={SOCIAL_LINKS.linkedin}
      aria-label="LinkedIn"
      title="LinkedIn"
      target="_blank"
      rel="noopener noreferrer"
      class={linkClass}
    >
      <svg
        class={iconClass}
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"
        />
      </svg>
    </a>
  </li>
  <li>
    <a href={SOCIAL_LINKS.rss} aria-label="RSS" title="RSS" class={linkClass}>
      <Rss class={iconClass} aria-hidden="true" />
    </a>
  </li>
</ul>
