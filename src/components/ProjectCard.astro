---
import type { CollectionEntry } from 'astro:content';
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<a
  href={`/projects/${project.slug}`}
  class="group block rounded-lg border border-border bg-bg-elevated p-5 hover:border-border-strong transition-colors no-underline"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex flex-col gap-1">
      <h3 class="font-sans font-medium text-fg group-hover:text-accent transition-colors">
        {project.data.title}
      </h3>
      <p class="text-sm text-fg-muted">{project.data.summary}</p>
    </div>
    <ArrowUpRight
      class="h-4 w-4 flex-shrink-0 text-fg-subtle group-hover:text-accent transition-colors"
      aria-hidden="true"
    />
  </div>

  {
    project.data.stack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {project.data.stack.map((tag) => (
          <li class="text-xs font-mono text-fg-subtle border border-border rounded px-1.5 py-0.5">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</a>
