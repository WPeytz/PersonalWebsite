---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { Pencil } from '@lucide/astro';
import { editUrl } from '@/consts';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = entry.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const editHref = editUrl(`src/content/blog/${entry.id}`);
---

<BaseLayout title={title} description={description} image={heroImage} article>
  <article class="container-content py-16">
    <header class="mb-10">
      <p class="text-sm text-fg-subtle font-mono">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && (
          <span> · updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></span>
        )}
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tightest">{title}</h1>
      <p class="mt-3 text-lg text-fg-muted">{description}</p>
    </header>

    {
      heroImage && (
        <img
          src={heroImage}
          alt=""
          class="mb-10 w-full rounded-lg border border-border"
        />
      )
    }

    <div class="prose-site">
      <slot />
    </div>

    <footer class="mt-12 pt-6 border-t border-border">
      <a
        href={editHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm text-fg-muted hover:text-fg no-underline"
      >
        <Pencil class="h-3.5 w-3.5" aria-hidden="true" />
        Edit this page on GitHub
      </a>
    </footer>
  </article>
</BaseLayout>
