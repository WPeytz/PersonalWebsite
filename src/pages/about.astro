---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Download } from '@lucide/astro';
import { getEntry } from 'astro:content';

// Content is editable from the CMS (Pages → About).
const about = await getEntry('pages', 'about');
const { Content } = await about.render();
const { title, description, intro, portrait } = about.data;
---

<BaseLayout title={title} description={description}>
  <section class="container-content py-16">
    <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:gap-10">
      <div class="flex-1 min-w-0">
        <h1 class="text-4xl font-semibold tracking-tightest">{title}</h1>
        <p class="mt-6 text-lg text-fg-muted leading-relaxed">{intro}</p>
      </div>
      {
        portrait && (
          <div class="flex-shrink-0">
            <img
              src={portrait}
              alt="Portrait of William Peytz"
              width="176"
              height="176"
              class="h-40 w-40 sm:h-44 sm:w-44 rounded-lg object-cover border border-border-strong"
            />
          </div>
        )
      }
    </div>

    <div class="prose-site mt-10">
      <Content />
    </div>

    <div
      id="cv"
      class="mt-14 flex items-center justify-between gap-6 flex-wrap border-t border-border pt-10 scroll-mt-20"
    >
      <h2 class="text-2xl font-semibold tracking-tightest">CV</h2>
      <a
        href="/resume.pdf"
        class="inline-flex items-center gap-2 rounded-md border border-border-strong bg-bg-elevated px-4 py-2 text-sm text-fg hover:border-accent hover:text-accent transition-colors no-underline"
        download
      >
        <Download class="h-4 w-4" aria-hidden="true" />
        Download PDF
      </a>
    </div>

    <div class="prose-site mt-6">
      <h3>Experience</h3>
      <ul>
        <li>
          <strong>AI Engineer & Co-founder</strong> — Stemma, Copenhagen
          <br />
          <span class="text-fg-muted">2026</span>
          <ul>
            <li>Building a Danish-speaking AI phone assistant that handles real customer conversations, including appointment scheduling, bookings, and simple sales.</li>
            <li>Built and deployed a real-time voice AI pipeline combining ASR, LLMs, and TTS for natural phone conversations.</li>
            <li>Integrated telephony APIs, backend services, and business systems to enable end-to-end call automation.</li>
            <li>Working directly with pilot customers to validate product-market fit and continuously improve the product based on real-world usage.</li>
            <li>Leading product development from prototype to deployment as a technical co-founder.</li>
          </ul>
        </li>
        <li>
          <strong>AI Engineer & Co-founder</strong> — Simbolic, Copenhagen
          <br />
          <span class="text-fg-muted">2025 – 2026</span>
          <ul>
            <li>Built software infrastructure for engineering simulations with a focus on reproducibility and interoperability.</li>
            <li>Developed tooling to orchestrate simulation workflows across multiple engineering applications.</li>
            <li>Explored standardized interfaces for reproducible computational engineering pipelines.</li>
            <li>Worked on improving automation and developer experience for simulation workflows.</li>
          </ul>
        </li>
        <li>
          <strong>Mathematics Tutor</strong> — Toptutors, Copenhagen
          <br />
          <span class="text-fg-muted">2021 – 2022</span>
          <ul>
            <li>Tutored students in calculus, algebra, and probability.</li>
            <li>Designed interactive digital exercises using GeoGebra and TI-Nspire to improve conceptual understanding.</li>
          </ul>
        </li>
        <li>
          <strong>IT & Legal Assistant</strong> — Mette Klingsten Law Firm, Copenhagen
          <br />
          <span class="text-fg-muted">2017 – 2019</span>
          <ul>
            <li>Automated CRM workflows and document management processes.</li>
            <li>Built targeted email campaigns and supported the firm's digital operations.</li>
          </ul>
        </li>
      </ul>

      <h3>Selected Projects</h3>
      <p>
        Full case studies on the <a href="/projects">projects page</a>.
      </p>
      <ul>
        <li>
          <strong>EloQuiz.dk</strong> — Adaptive mathematics learning platform
          that personalizes question difficulty using an Elo-inspired rating
          system. Built the complete platform using Vue, Flask, Firebase, and
          the OpenAI API, and validated the concept through a student pilot.
        </li>
        <li>
          <strong>Anomaly Detection</strong> — Computer vision project for
          industrial defect detection using DINOv3 and the MVTec dataset.
          Implemented zero- and few-shot anomaly detection using embedding
          similarity and patch-level localization.
        </li>
        <li>
          <strong>Audio Classification</strong> — Deep learning pipeline for
          musical instrument recognition. Developed CNN and LSTM models capable
          of classifying 15 instrument classes with <strong>96–98% accuracy</strong>.
        </li>
        <li>
          <strong>EasyLINC 2.0</strong> — Accessible ride-ordering solution
          designed for elderly users. Led UX research, iterative prototyping,
          and user testing to improve accessibility and ease of use.
        </li>
      </ul>

      <h3>Education</h3>
      <ul>
        <li>
          <strong>MSc Human-Centered Artificial Intelligence</strong>
          <br />
          Technical University of Denmark (DTU)
          <br />
          <span class="text-fg-muted">2025 – 2027</span>
          <br />
          Focus areas include Deep Learning, Computer Vision, Computer Graphics,
          Human-AI Interaction, and Entrepreneurship.
        </li>
        <li>
          <strong>BSc Artificial Intelligence and Data</strong>
          <br />
          Technical University of Denmark (DTU)
          <br />
          <span class="text-fg-muted">2020 – 2025</span>
          <br />
          Bachelor's thesis: <strong>Adaptive Learning Systems (EloQuiz.dk)</strong>
          <br />
          Relevant topics included Machine Learning, Reinforcement Learning,
          MLOps, Software Engineering, and UX Design.
        </li>
        <li>
          <strong>Economics</strong>
          <br />
          University of Copenhagen
          <br />
          Completed one year of undergraduate studies in Economics.
        </li>
      </ul>

      <h3>Technical Skills</h3>
      <h4>Programming Languages</h4>
      <ul>
        <li>Python</li>
        <li>TypeScript</li>
        <li>SQL</li>
      </ul>
      <h4>AI & Machine Learning</h4>
      <ul>
        <li>PyTorch</li>
        <li>scikit-learn</li>
        <li>Deep Learning</li>
        <li>Large Language Models</li>
        <li>Voice AI</li>
        <li>OpenAI API</li>
      </ul>
      <h4>Backend</h4>
      <ul>
        <li>FastAPI</li>
        <li>Flask</li>
      </ul>
      <h4>Frontend</h4>
      <ul>
        <li>Vue.js</li>
        <li>React</li>
      </ul>
      <h4>Infrastructure</h4>
      <ul>
        <li>Docker</li>
        <li>Firebase</li>
        <li>Supabase</li>
        <li>Vercel</li>
      </ul>

      <h3>Languages</h3>
      <ul>
        <li>Danish (Native)</li>
        <li>English (Fluent)</li>
      </ul>

      <h3>Contact</h3>
      <ul>
        <li><strong>Email:</strong> <a href="mailto:williamhkp@gmail.com">williamhkp@gmail.com</a></li>
        <li><strong>Website:</strong> <a href="https://williampeytz.com">williampeytz.com</a></li>
        <li><strong>GitHub:</strong> <a href="https://github.com/WPeytz" target="_blank" rel="noopener noreferrer">github.com/WPeytz</a></li>
        <li><strong>LinkedIn:</strong> <a href="https://www.linkedin.com/in/William-Peytz/" target="_blank" rel="noopener noreferrer">linkedin.com/in/William-Peytz</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
