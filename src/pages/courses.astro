---
import BaseLayout from '@layouts/BaseLayout.astro';
import { COURSES, PROGRAMS, type Program } from '@/data/courses';

const programOrder: Program[] = ['msc', 'bsc', 'other'];

const grouped = programOrder
  .map((p) => ({
    program: p,
    meta: PROGRAMS[p],
    courses: COURSES.filter((c) => c.program === p),
  }))
  .filter((g) => g.courses.length > 0);

const totalEcts = COURSES.reduce((sum, c) => sum + (c.ects ?? 0), 0);
---

<BaseLayout
  title="Courses"
  description="Coursework taken by William Peytz across DTU and the University of Copenhagen."
>
  <section class="container-content py-16">
    <header class="mb-10">
      <h1 class="text-4xl font-semibold tracking-tightest">Courses</h1>
      <p class="mt-3 text-fg-muted">
        Coursework I've taken across my BSc and MSc — full list, grouped
        by programme.
      </p>
      {
        totalEcts > 0 && (
          <p class="mt-2 text-sm text-fg-subtle font-mono">
            {COURSES.length} courses · {totalEcts} ECTS
          </p>
        )
      }
    </header>

    <div class="flex flex-col gap-12">
      {
        grouped.map(({ program, meta, courses }) => (
          <section>
            <header class="mb-4">
              <h2 class="text-xl font-semibold tracking-tightest">{meta.label}</h2>
              {meta.sublabel && (
                <p class="text-sm text-fg-subtle font-mono mt-1">{meta.sublabel}</p>
              )}
            </header>

            <ul class="flex flex-col">
              {courses.map((course) => (
                <li class="flex items-baseline justify-between gap-4 py-3 border-b border-border">
                  <div class="flex flex-col gap-0.5 min-w-0">
                    <div class="flex items-baseline gap-2 flex-wrap">
                      {course.code && (
                        <span class="text-xs font-mono text-fg-subtle">
                          {course.code}
                        </span>
                      )}
                      <span class="text-fg">{course.title}</span>
                      {course.institution && course.institution !== 'DTU' && (
                        <span class="text-xs font-mono text-fg-subtle">
                          · {course.institution}
                        </span>
                      )}
                    </div>
                    {course.description && (
                      <p class="text-sm text-fg-muted">{course.description}</p>
                    )}
                  </div>
                  <div class="flex items-baseline gap-3 flex-shrink-0 text-xs font-mono text-fg-subtle whitespace-nowrap">
                    {course.ects !== undefined && <span>{course.ects} ECTS</span>}
                    <span>{course.year}</span>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
