---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Download } from '@lucide/astro';
---

<BaseLayout
  title="CV"
  description="CV / resume for William Peytz — AI engineer and MSc Human-Centered AI student at DTU."
>
  <section class="container-content py-16">
    <div class="flex items-start justify-between gap-6 flex-wrap">
      <div>
        <h1 class="text-4xl font-semibold tracking-tightest">CV</h1>
        <p class="mt-2 text-fg-muted">Copenhagen, Denmark</p>
      </div>
      <a
        href="/resume.pdf"
        class="inline-flex items-center gap-2 rounded-md border border-border-strong bg-bg-elevated px-4 py-2 text-sm text-fg hover:border-accent hover:text-accent transition-colors no-underline"
        download
      >
        <Download class="h-4 w-4" aria-hidden="true" />
        Download PDF
      </a>
    </div>

    <div class="prose-site mt-10">
      <h2>Profile</h2>
      <p>
        AI engineer and startup builder pursuing an MSc in Human-Centered AI at
        DTU. Focused on building real-world AI systems, from adaptive learning
        platforms to voice-based AI agents handling live customer interactions.
        Strong in rapid prototyping, full-stack development, and applying
        machine learning to real user problems.
      </p>

      <h2>Experience</h2>
      <ul>
        <li>
          <strong>AI Engineer & Cofounder</strong> — Stemma, Copenhagen
          <br />
          <span class="text-fg-muted">2026 – Present</span>
          <ul>
            <li>Building Danish-speaking AI phone assistant for handling inbound calls (scheduling, bookings, sales).</li>
            <li>Designed and deployed a real-time voice pipeline (ASR → LLM → TTS).</li>
            <li>Integrating telephony APIs and backend systems for live call handling.</li>
            <li>Running pilot customers to validate product-market fit and quantify missed-call conversion.</li>
          </ul>
        </li>
        <li>
          <strong>AI Engineer & Cofounder</strong> — Simbolic, Copenhagen
          <br />
          <span class="text-fg-muted">2025 – 2026</span>
          <ul>
            <li>Built infrastructure for orchestrating engineering simulations across tools.</li>
            <li>Explored standardized interfaces for reproducible simulation workflows.</li>
          </ul>
        </li>
        <li>
          <strong>Mathematics Tutor</strong> — Toptutors, Copenhagen
          <br />
          <span class="text-fg-muted">2021 – 2022</span>
          <ul>
            <li>Tutored calculus, algebra, and probability. Developed custom digital exercises with GeoGebra and TI-Nspire.</li>
          </ul>
        </li>
        <li>
          <strong>IT & Legal Assistant</strong> — Mette Klingsten Law Firm, Copenhagen
          <br />
          <span class="text-fg-muted">2017 – 2019</span>
          <ul>
            <li>Automated CRM workflows and document handling. Designed targeted email campaigns.</li>
          </ul>
        </li>
      </ul>

      <h2>Selected Projects</h2>
      <p>
        Full case studies on the <a href="/projects">projects page</a>.
      </p>
      <ul>
        <li>
          <strong>EloQuiz.dk</strong> — Adaptive math learning platform with an
          Elo-based difficulty system. Full-stack (Vue, Flask, Firebase, OpenAI
          API), validated through a student pilot.
        </li>
        <li>
          <strong>Anomaly Detection</strong> — Zero- and few-shot industrial
          defect detection using DINOv3 on the MVTec dataset. Embedding
          similarity and patch-level anomaly localization.
        </li>
        <li>
          <strong>Audio Classification</strong> — CNN/LSTM models classifying
          15 instruments. Achieved 96–98% accuracy with tuning and validation.
        </li>
        <li>
          <strong>EasyLINC 2.0</strong> — Ride-ordering solution for elderly
          users with focus on accessibility. Led iterative UX prototyping and
          user testing.
        </li>
      </ul>

      <h2>Education</h2>
      <ul>
        <li>
          <strong>MSc Human-Centered Artificial Intelligence</strong> — Technical University of Denmark (DTU)
          <br />
          <span class="text-fg-muted">2025 – 2027</span>
          <br />
          Courses: Deep Learning, Computer Vision, Computer Graphics, X-Tech Entrepreneurship.
        </li>
        <li>
          <strong>BSc Artificial Intelligence and Data</strong> — Technical University of Denmark (DTU)
          <br />
          <span class="text-fg-muted">2020 – 2025</span>
          <br />
          Thesis: Adaptive Learning Systems (EloQuiz.dk).
          <br />
          Relevant: Machine Learning, Reinforcement Learning, MLOps, UX Design, Software Engineering.
        </li>
        <li>
          <strong>Economics</strong> (1 year) — University of Copenhagen
        </li>
      </ul>

      <h2>Skills</h2>
      <ul>
        <li><strong>ML:</strong> PyTorch, scikit-learn, deep learning</li>
        <li><strong>Backend:</strong> Python, Flask, FastAPI</li>
        <li><strong>Frontend:</strong> Vue.js, React</li>
        <li><strong>Infra:</strong> Docker, Firebase, Supabase, Vercel</li>
        <li><strong>AI:</strong> LLMs, voice pipelines, OpenAI API</li>
      </ul>

      <h2>Languages</h2>
      <ul>
        <li>Danish (native)</li>
        <li>English (fluent)</li>
      </ul>

      <h2>Get in touch</h2>
      <p>
        <a href="mailto:williamhkp@gmail.com">williamhkp@gmail.com</a> ·
        <a href="https://github.com/WPeytz" target="_blank" rel="noopener noreferrer">GitHub</a> ·
        <a href="https://www.linkedin.com/in/William-Peytz/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </p>
    </div>
  </section>
</BaseLayout>
