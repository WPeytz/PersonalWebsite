---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import PostCard from '@components/PostCard.astro';
import { ArrowRight } from '@lucide/astro';
import projectOrder from '@/data/project-order.json';

// Same ordering as /projects — controlled from the CMS "Project order" screen.
const orderList = projectOrder.order.map((o) => o.project);
const rank = (slug: string) => {
  const i = orderList.indexOf(slug);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};

const allProjects = await getCollection('projects', ({ data }) => !data.draft);

const projects = [...allProjects]
  .sort((a, b) => {
    const diff = rank(a.slug) - rank(b.slug);
    return diff !== 0 ? diff : (a.data.order ?? 0) - (b.data.order ?? 0);
  })
  .slice(0, 4);

const newestProjectSlugs = [
  'gpt-50m-pytorch',
  'danish-university-admissions-2026',
  'agentarena',
  'oak',
];
const newestProjects = allProjects
  .filter((project) => newestProjectSlugs.includes(project.slug))
  .sort(
    (a, b) =>
      newestProjectSlugs.indexOf(a.slug) - newestProjectSlugs.indexOf(b.slug),
  );

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="container-wide py-20 sm:py-28">
    <div class="flex flex-col-reverse gap-10 sm:flex-row sm:items-center sm:gap-12">
      <div class="max-w-2xl">
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tightest leading-[1.05]">
          Hi, I'm William.
        </h1>
        <p class="mt-6 text-lg text-fg-muted leading-relaxed">
          AI engineer and startup builder based in Copenhagen. I'm pursuing an
          MSc in Human-Centered AI at DTU, expecting to graduate June 2027. I like turning
          machine learning into things real people actually use.
        </p>
      </div>
      <div class="flex-shrink-0">
        <img
          src="/portrait.jpg"
          alt="Portrait of William Peytz"
          width="240"
          height="240"
          class="h-48 w-48 sm:h-56 sm:w-56 rounded-lg object-cover border border-border-strong"
        />
      </div>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="container-wide py-12 border-t border-border">
        <div class="flex items-baseline justify-between gap-4 mb-8">
          <h2 class="text-xl font-semibold tracking-tightest">Selected projects</h2>
          <a
            href="/projects"
            class="text-sm text-fg-muted hover:text-fg inline-flex items-center gap-1 no-underline"
          >
            All projects <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )
  }

  {
    newestProjects.length > 0 && (
      <section class="container-wide py-12 border-t border-border">
        <div class="flex items-baseline justify-between gap-4 mb-8">
          <h2 class="text-xl font-semibold tracking-tightest">Newest projects</h2>
          <a
            href="/projects"
            class="text-sm text-fg-muted hover:text-fg inline-flex items-center gap-1 no-underline"
          >
            All projects <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {newestProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="container-wide py-12 border-t border-border">
        <div class="flex items-baseline justify-between gap-4 mb-4">
          <h2 class="text-xl font-semibold tracking-tightest">Recent writing</h2>
          <a
            href="/blog"
            class="text-sm text-fg-muted hover:text-fg inline-flex items-center gap-1 no-underline"
          >
            All posts <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>
        <div class="flex flex-col">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )
  }
</BaseLayout>
