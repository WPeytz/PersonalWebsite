---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ArrowUpRight } from '@lucide/astro';

// Games now live at peytzgames.com — this page links there. `thumbnail` is
// optional; without one a styled placeholder with the game's title is shown.
const games = [
  {
    title: 'Blocks',
    description: 'A browser puzzle game.',
    href: '/games/blocks',
    external: false,
    thumbnail: undefined as string | undefined,
  },
  {
    title: 'LifeRunner.io',
    description: 'A life simulation where time, energy, and money are limited.',
    href: 'https://peytzgames.com/play/liferunner',
    external: true,
    thumbnail: undefined as string | undefined,
  },
  {
    title: 'LastNameLegacy',
    description: 'Guess the first name behind a famous surname. Scored by AI.',
    href: 'https://peytzgames.com/play/lastnamelegacy',
    external: true,
    thumbnail: undefined as string | undefined,
  },
  {
    title: 'EloQuiz.dk',
    description: 'Adaptive math practice with an Elo-rating system.',
    href: 'https://peytzgames.com/play/eloquiz',
    external: true,
    thumbnail: undefined as string | undefined,
  },
  {
    title: 'PeytzPvP',
    description: 'Hardcore Games-style PvP for Minecraft Paper servers.',
    href: 'https://peytzgames.com/play/peytzpvp',
    external: true,
    thumbnail: undefined as string | undefined,
  },
];
---

<BaseLayout
  title="Games"
  description="Small browser games and experiments by William Peytz — released on PeytzGames.com."
>
  <section class="container-wide py-16">
    <header
      class="mb-10 flex flex-wrap items-end justify-between gap-6"
    >
      <div class="max-w-2xl">
        <h1 class="text-4xl font-semibold tracking-tightest">Games</h1>
        <p class="mt-3 text-fg-muted">
          Small browser games and interactive experiments. New games are
          released on
          <a
            href="https://peytzgames.com"
            target="_blank"
            rel="noopener noreferrer">PeytzGames.com</a
          >.
        </p>
      </div>
      <a
        href="https://peytzgames.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md border border-border-strong bg-bg-elevated px-4 py-2 text-sm text-fg hover:border-accent hover:text-accent transition-colors no-underline"
      >
        Visit PeytzGames.com
        <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        games.map((game) => (
          <a
            href={game.href}
            target={game.external ? '_blank' : undefined}
            rel={game.external ? 'noopener noreferrer' : undefined}
            class="group block overflow-hidden rounded-lg border border-border bg-bg-elevated hover:border-border-strong transition-colors no-underline"
          >
            <div class="aspect-video w-full overflow-hidden bg-bg">
              {game.thumbnail ? (
                <img
                  src={game.thumbnail}
                  alt={`${game.title} thumbnail`}
                  class="h-full w-full object-cover transition-transform group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-bg-elevated to-bg">
                  <span class="font-sans text-2xl font-semibold tracking-tightest text-fg-subtle">
                    {game.title}
                  </span>
                </div>
              )}
            </div>
            <div class="flex items-start justify-between gap-4 p-5">
              <div class="flex flex-col gap-1">
                <h3 class="font-sans font-medium text-fg group-hover:text-accent transition-colors">
                  {game.title}
                </h3>
                <p class="text-sm text-fg-muted">{game.description}</p>
              </div>
              <ArrowUpRight
                class="h-4 w-4 flex-shrink-0 text-fg-subtle group-hover:text-accent transition-colors"
                aria-hidden="true"
              />
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
