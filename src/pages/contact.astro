---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Mail, MapPin, ArrowUpRight } from '@lucide/astro';

const email = 'williamhkp@gmail.com';
const links = [
  {
    href: 'https://github.com/WPeytz',
    label: 'GitHub',
    handle: '@WPeytz',
  },
  {
    href: 'https://www.linkedin.com/in/William-Peytz/',
    label: 'LinkedIn',
    handle: 'William Peytz',
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with William Peytz."
>
  <section class="container-content py-16">
    <h1 class="text-4xl font-semibold tracking-tightest">Get in touch</h1>
    <p class="mt-3 text-fg-muted">
      The fastest way to reach me is by email. I read everything; I try
      to reply quickly.
    </p>

    <a
      href={`mailto:${email}`}
      class="mt-10 group flex items-center justify-between gap-4 rounded-lg border border-border-strong bg-bg-elevated p-5 hover:border-accent transition-colors no-underline"
    >
      <span class="flex items-center gap-3">
        <Mail class="h-5 w-5 text-fg-muted group-hover:text-accent transition-colors" aria-hidden="true" />
        <span class="flex flex-col">
          <span class="text-xs uppercase tracking-wide text-fg-subtle">Email</span>
          <span class="font-mono text-fg">{email}</span>
        </span>
      </span>
      <ArrowUpRight class="h-4 w-4 text-fg-subtle group-hover:text-accent transition-colors" aria-hidden="true" />
    </a>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        links.map(({ href, label, handle }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 rounded-lg border border-border bg-bg-elevated p-5 hover:border-border-strong transition-colors no-underline h-full"
            >
              <span class="flex flex-col">
                <span class="text-xs uppercase tracking-wide text-fg-subtle">{label}</span>
                <span class="text-fg">{handle}</span>
              </span>
              <ArrowUpRight class="h-4 w-4 text-fg-subtle group-hover:text-fg transition-colors" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 inline-flex items-center gap-2 text-sm text-fg-muted">
      <MapPin class="h-4 w-4" aria-hidden="true" />
      Copenhagen, Denmark
    </p>
  </section>
</BaseLayout>
