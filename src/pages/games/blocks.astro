---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';

// The game is deployed standalone at blocks.williampeytz.com and embedded here
// so the site header/footer wrap around it.
const GAME_URL = 'https://blocks.williampeytz.com';
---

<BaseLayout
  title="Blocks"
  description="Play Blocks — an original browser falling-block puzzle game by William Peytz."
>
  <section class="container-wide py-8">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <a
          href="/games"
          class="mb-2 inline-flex items-center gap-1 text-sm text-fg-muted hover:text-accent transition-colors no-underline"
        >
          <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
          Games
        </a>
        <h1 class="text-4xl font-semibold tracking-tightest">Blocks</h1>
        <p class="mt-3 text-fg-muted">
          An original falling-block puzzle. Click the board, then use the arrow
          keys to play.
        </p>
      </div>
      <a
        href={GAME_URL}
        class="inline-flex items-center gap-1 rounded-md border border-border bg-bg-elevated px-3 py-1.5 text-sm text-fg-muted hover:border-border-strong hover:text-accent transition-colors no-underline"
      >
        Open fullscreen
        <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </header>

    <div
      class="overflow-hidden rounded-lg border border-border bg-bg-elevated"
    >
      <iframe
        src={GAME_URL}
        title="Blocks — falling-block puzzle game"
        class="block h-[80vh] min-h-[640px] w-full border-0"
        allow="fullscreen; autoplay"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</BaseLayout>
