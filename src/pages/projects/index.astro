---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import projectOrder from '@/data/project-order.json';

// Display order is controlled from the CMS "Project order" screen (drag to
// reorder). Any project not listed there falls to the end, ordered by its own
// `order` field — so newly added projects never disappear.
const orderList = projectOrder.order.map((o) => o.project);
const rank = (slug: string) => {
  const i = orderList.indexOf(slug);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => {
    const diff = rank(a.slug) - rank(b.slug);
    return diff !== 0 ? diff : (a.data.order ?? 0) - (b.data.order ?? 0);
  });
---

<BaseLayout
  title="Projects"
  description="Projects and case studies by William Peytz."
>
  <section class="container-wide py-16">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-4xl font-semibold tracking-tightest">Projects</h1>
      <p class="mt-3 text-fg-muted">
        Things I've built or contributed to. Each one has a short case study.
      </p>
    </header>

    {
      projects.length === 0 ? (
        <p class="text-fg-muted">Nothing here yet.</p>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
